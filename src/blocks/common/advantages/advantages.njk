{% from "data/home.njk" import advantages %}
{% from "components/common/advantage-item/advantage-item.njk" import render as advantageItem %}

<section class="advantages" aria-labelledby="advantages-title" data-advantages>
    <div class="container">
        <div class="advantages-card">
            <h2 class="advantages-title" id="advantages-title">{{ advantages.title }}</h2>
            <ul class="advantages-list">
                {% for item in advantages.items %}
                    {{ advantageItem(item) }}
                {% endfor %}
            </ul>
        </div>
    </div>
</section>
