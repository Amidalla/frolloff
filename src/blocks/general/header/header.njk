{% from "components/general/navigation-top/navigation-top.njk" import render as navigationTop %}
{% from "components/general/logo/logo.njk" import render as logo %}

<header class="header">
    <div class="header-main">
        <div class="container">
            <div class="block">
                <div class="wrap">{{ logo(image="./assets/images/system/logo.svg", imageMobile="./assets/images/system/logo-mini.svg", alt="Froloff") }}</div>
                <div class="wrap">
                    {{ navigationTop(
                        items=[
                            { title: "О нас", href: "#about" },
                            { title: "Услуги", href: "#services" },
                            { title: "Вопросы", href: "#faq" },
                            { title: "Контакты", href: "#contacts" }
                        ]
                    ) }}
                </div>
                <div class="wrap">
                    {% include "components/common/contacts-header/contacts-header.njk" %}
                </div>
                <div class="wrap">
                    {% include "components/general/menu/menu-open.njk" %}
                </div>
            </div>
        </div>
    </div>
</header>
