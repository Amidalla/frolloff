{% from "data/site.njk" import footerNav, contacts, company %}
{% from "components/general/logo/logo.njk" import render as logo %}
{% from "components/general/navigation-bottom/navigation-bottom.njk" import render as navigationBottom %}

<footer class="footer" id="contacts">
    <div class="container">
        <div class="footer-inner">
            {{ logo(href="./home.html", image="./assets/images/system/logo-footer.svg", alt="Froloff", class="footer-logo", width="289", height="86") }}

            <div class="footer-about">
                <p class="footer-tagline">{{ company.tagline }}</p>
                <p class="footer-product">{{ company.product }}</p>
                <p class="footer-disclaimer">{{ company.disclaimer }}</p>
            </div>

            {% for column in footerNav %}
                {{ navigationBottom(title=column.title, items=column.items, class="footer-nav") }}
            {% endfor %}
            {{ navigationBottom(title="Контакты", items=contacts, class="footer-nav footer-contacts") }}

            <div class="footer-bottom">
                <p class="footer-copyright">{{ company.copyright }}</p>
                <p class="footer-requisites">{{ company.requisites }}</p>
            </div>
        </div>
    </div>
</footer>
