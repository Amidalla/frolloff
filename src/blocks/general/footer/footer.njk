{% from "components/general/logo/logo.njk" import render as logo %}
{% from "components/general/navigation-bottom/navigation-bottom.njk" import render as navigationBottom %}

<footer class="footer" id="contacts">
    <div class="footer-main">
        <div class="container">
            <div class="block">
                <div class="column">
                    <div class="wrap">
                        {{ logo(image="./assets/images/system/logo-variant.svg", alt="Froloff") }}
                    </div>
                    <div class="wrap">
                        {% include "components/common/contacts-footer/contacts-footer.njk" %}
                    </div>
                </div>
                <div class="wrap">
                    {{ navigationBottom(
                        title="Навигация",
                        items=[
                            { title: "О нас", href: "#about" },
                            { title: "Услуги", href: "#services" },
                            { title: "Вопросы", href: "#faq" },
                            { title: "Контакты", href: "#contacts" }
                        ]
                    ) }}
                </div>
                <div class="wrap">
                    {% include "components/common/email-footer/email-footer.njk" %}
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container">
            <div class="block">
                {% include "components/common/copyright/copyright.njk" %}
            </div>
        </div>
    </div>
</footer>
