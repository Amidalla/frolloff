{% macro render(
        text="",
        variant="gold",
        size="m",
        type="button",
        href="#",
        target="",
        rel="",
        download=false,
        id="",
        name="",
        value="",
        disabled=false,
        class="",
        data={},
        aria={}
    ) %}
    {# variant: gold | blue | border; size: l | m | s #}
    {% set buttonClasses = "button " + variant + " " + size %}
    {% if class %}
        {% set buttonClasses = buttonClasses + " " + class %}
    {% endif %}

    {% if type == "link" %}
        <a
            class="{{ buttonClasses }}{% if disabled %} disabled{% endif %}"
            {% if id %}id="{{ id }}"{% endif %}
            href="{{ href }}"
            {% if target %}target="{{ target }}"{% endif %}
            {% if rel %}rel="{{ rel }}"{% endif %}
            {% if download %}download{% endif %}
            {% if data %}
                {% for key, val in data %}
                    data-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
            {% if aria %}
                {% for key, val in aria %}
                    aria-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
        >
            {% if text %}
                <span>{{ text }}</span>
            {% endif %}
        </a>
    {% else %}
        <button
            class="{{ buttonClasses }}"
            {% if id %}id="{{ id }}"{% endif %}
            type="{{ type }}"
            {% if name %}name="{{ name }}"{% endif %}
            {% if value %}value="{{ value }}"{% endif %}
            {% if data %}
                {% for key, val in data %}
                    data-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
            {% if aria %}
                {% for key, val in aria %}
                    aria-{{ key | replace("_", "-") }}="{{ val }}"
                {% endfor %}
            {% endif %}
            {% if disabled %}disabled{% endif %}
        >
            {% if text %}
                <span>{{ text }}</span>
            {% endif %}
        </button>
    {% endif %}
{% endmacro %}