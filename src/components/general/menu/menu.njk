{% from "data/site.njk" import mainNav, contacts, cta %}
{% from "components/general/navigation-mobile/navigation-mobile.njk" import render as navigationMobile %}
{% from "components/general/button/button.njk" import render as button %}
{% from "components/common/contacts-list/contacts-list.njk" import render as contactsList %}
{% from "components/general/image/image.njk" import render as image %}

<div class="menu" id="menu" data-dropdown="menu">
    <div class="menu-header">
        <span class="menu-title">Меню</span>
        {% include "components/general/menu/menu-close.njk" %}
    </div>

    <div class="menu-body">
        {{ navigationMobile(items=mainNav, ariaLabel="Меню") }}

        {{ button(text=cta.text, href=cta.href, type="link", variant="border", size="s", class="medium menu-cta") }}

        {{ contactsList(items=contacts, class="menu-contacts") }}
    </div>

    {{ image(src="./assets/images/system/wordmark.svg", width=66, height=383, class="menu-wordmark", decorative=true) }}
</div>
