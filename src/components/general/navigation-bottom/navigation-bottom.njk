{#
    Колонка ссылок с заголовком (подвал).
    В 1С-Битрикс: заголовок + шаблон компонента bitrix:menu (ul > li > a).
    items: [{ title, href, target, ariaCurrent, class }]
    linkBase — префикс для якорных ссылок на других страницах («./home.html» → «./home.html#faq»)
#}
{% macro render(
        title="",
        items=[],
        class="",
        ariaLabel="",
        linkBase=""
    ) %}
    {% set navClasses = "navigation-bottom" %}
    {% if class %}
        {% set navClasses = navClasses + " " + class %}
    {% endif %}

    <nav class="{{ navClasses }}" aria-label="{{ ariaLabel if ariaLabel else title }}">
        {% if title %}
            <p class="title">{{ title }}</p>
        {% endif %}
        <ul>
            {% for item in items %}
                <li{% if item.class %} class="{{ item.class }}"{% endif %}>
                    <a
                        href="{{ (linkBase + item.href) if (linkBase and item.href.indexOf("#") == 0 and item.href != "#") else item.href }}"
                        {% if item.target %}
                            target="{{ item.target }}" rel="noopener"
                        {% endif %}
                        {% if item.ariaCurrent %}
                            aria-current="{{ item.ariaCurrent }}"
                        {% endif %}
                    >
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endmacro %}
