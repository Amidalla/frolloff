{#
    Горизонтальное меню. В 1С-Битрикс — шаблон компонента bitrix:menu (ul > li > a).
    items: [{ title, href, target, ariaCurrent, class }]
#}
{% macro render(
        items=[],
        class="",
        ariaLabel="Навигация"
    ) %}
    {% set navClasses = "navigation-top" %}
    {% if class %}
        {% set navClasses = navClasses + " " + class %}
    {% endif %}

    <nav class="{{ navClasses }}" aria-label="{{ ariaLabel }}">
        <ul>
            {% for item in items %}
                <li{% if item.class %} class="{{ item.class }}"{% endif %}>
                    <a
                        href="{{ item.href }}"
                        {% if item.target %}
                            target="{{ item.target }}"
                        {% endif %}
                        {% if item.ariaCurrent %}
                            aria-current="{{ item.ariaCurrent }}"
                        {% endif %}
                    >
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endmacro %}
