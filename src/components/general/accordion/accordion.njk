{% macro render(
        items=[],
        openFirst=true,
        id="accordion",
        class="",
        data={},
        aria={}
    ) %}
    {% set accordionClasses = "accordion" %}
    {% if class %}
        {% set accordionClasses = accordionClasses + " " + class %}
    {% endif %}

    <div
        class="{{ accordionClasses }}"
        data-accordion="component"
        id="{{ id }}"
        {% if data %}
            {% for key, val in data %}
                data-{{ key | replace("_", "-") }}="{{ val }}"
            {% endfor %}
        {% endif %}
        {% if aria %}
            {% for key, val in aria %}
                aria-{{ key | replace("_", "-") }}="{{ val }}"
            {% endfor %}
        {% endif %}
    >
        {% for item in items %}
            {% set open = openFirst and loop.first %}
            <div class="item{% if open %} is-open{% endif %}" data-accordion-item>
                <button
                    type="button"
                    class="panel"
                    id="{{ id }}-panel-{{ loop.index }}"
                    aria-expanded="{{ 'true' if open else 'false' }}"
                    aria-controls="{{ id }}-content-{{ loop.index }}"
                >
                    <span class="name">{{ item.name }}</span>
                    <span class="icon" aria-hidden="true">
                        <svg viewBox="0 0 26 26" focusable="false">
                            <path d="M1 13H25M13 1V25" />
                        </svg>
                    </span>
                </button>
                <div
                    class="collapse"
                    id="{{ id }}-content-{{ loop.index }}"
                    role="region"
                    aria-labelledby="{{ id }}-panel-{{ loop.index }}"
                    {% if not open %}hidden{% endif %}
                >
                    <div class="wrap" data-editor>{{ item.content | safe }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
