{#
    Карточка товара каталога: название, граммовка, фото (PNG без фона).
    При наведении (десктоп) карточка вырастает, заливается цветом темы, показывает описание и кнопку.
    item: { name, weight, kind: box|jar, image, alt, text, markets: { ozon, wb, ym } }
    Кнопка «Купить» и тап по карточке (без ховера) открывают модалку «Где купить» с этими ссылками.
    theme: bordo | navy | gold; buyText — текст кнопки
#}
{% from "components/general/image/image.njk" import render as image %}

{% macro render(item, theme="bordo", buyText="Купить на маркетплейсах", class="") %}
    {% set leafHover = {
        bordo: "product-leaf-milk.svg",
        navy: "product-leaf-sage.svg",
        gold: "product-leaf-green.svg"
    } %}
    {% set markets = item.markets or {} %}
    <article
        class="product-card {{ theme }} {{ item.kind }}{% if class %} {{ class }}{% endif %}"
        data-ozon="{{ markets.ozon or "#" }}"
        data-wb="{{ markets.wb or "#" }}"
        data-ym="{{ markets.ym or "#" }}"
    >
        <div class="inner">
            {{ image(src="./assets/images/system/product-leaf.svg", width=121, height=206, class="leaf", decorative=true) }}
            {{ image(src="./assets/images/system/" + leafHover[theme], width=251, height=399, class="leaf-hover", decorative=true) }}

            <div class="head">
                <h4 class="name">{{ item.name }}</h4>
                <p class="weight">{{ item.weight }}</p>
            </div>

            <div class="media">
                {% if item.kind == "jar" %}
                    {{ image(src=item.image, width=640, height=857, alt=item.alt) }}
                {% else %}
                    {{ image(src=item.image, width=560, height=840, alt=item.alt) }}
                {% endif %}
            </div>

            <div class="details">
                <p class="text">{{ item.text }}</p>
                <a class="buy" href="#modal-shop" aria-haspopup="dialog">{{ buyText }}</a>
            </div>
        </div>
    </article>
{% endmacro %}
