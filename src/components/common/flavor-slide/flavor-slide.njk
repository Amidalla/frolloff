{#
    Слайд вкуса: название + бейдж (например «Топ-1») + фото.
    slide: { name, badge, image, alt, markets: { ozon, wb, ym } } — ссылки для модалки «Где купить»
#}
{% from "components/general/image/image.njk" import render as image %}

{% macro render(slide, class="") %}
    {% set markets = slide.markets or {} %}
    <div
        class="swiper-slide flavor-slide{% if class %} {{ class }}{% endif %}"
        data-ozon="{{ markets.ozon or "#" }}"
        data-wb="{{ markets.wb or "#" }}"
        data-ym="{{ markets.ym or "#" }}"
    >
        <div class="head">
            <p class="name">{{ slide.name }}</p>
            {% if slide.badge %}
                <p class="badge">{{ slide.badge }}</p>
            {% endif %}
        </div>
        <div class="media">
            {# Фото двигается за мышью (data-attract) — сдвигается только img внутри слайда, логику Swiper не трогает #}
            {{ image(src=slide.image, width=1024, height=765, alt=slide.alt, data={ attract: "0.02" }) }}
        </div>
    </div>
{% endmacro %}
