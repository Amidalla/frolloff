{% set title = "Froloff" %}
{% set url = "https://froloff.ru/" %}
{% set figma = "https://www.figma.com/design/2aJqj27cTCZuEJbY18Cxi3/Froloff?node-id=115-749&t=qkkkH9zax0gXhqf7-0" %}
{% set github = "https://github.com/Amidalla/frolloff" %}
{% set fontFaces = [
    { family: "Montserrat", file: "montserrat", weight: 400 },
    { family: "Montserrat", file: "montserrat", weight: 500 },
    { family: "Montserrat", file: "montserrat", weight: 600 },
    { family: "Cormorant SC", file: "cormorant-sc", weight: 600 }
] %}

{% macro pageLink(title, file) %}
    <li>
        <a href="./{{ file }}">
            <span class="link-text"><span class="name">{{ title }}</span><span class="file">{{ file }}</span></span>
            <span class="arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
            </span>
        </a>
    </li>
{% endmacro %}
<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ title }} — карта страниц</title>
        <style>
            {% for font in fontFaces %}
            @font-face {
                font-family: "{{ font.family }}";
                font-style: normal;
                font-weight: {{ font.weight }};
                src: url("./assets/fonts/{{ font.file }}-cyrillic-{{ font.weight }}.woff2") format("woff2");
                font-display: swap;
                unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
            }

            @font-face {
                font-family: "{{ font.family }}";
                font-style: normal;
                font-weight: {{ font.weight }};
                src: url("./assets/fonts/{{ font.file }}-latin-{{ font.weight }}.woff2") format("woff2");
                font-display: swap;
                unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2122, U+2191, U+2193, U+2212, U+FEFF, U+FFFD;
            }
            {% endfor %}

            :root {
                --color-gold: #d79b57;
                --color-navy: #0c2348;
                --color-navy-dark: #031b36;
                --color-ink: #17212b;
                --color-milk: #f1f1de;
                --color-cream: #f9f9f2;
                --gradient-gold: linear-gradient(270deg, #c49d5a 0%, #feca85 48.077%, #c49d5a 100%);
                --gradient-gold-button: linear-gradient(216deg, #c49d5a 18%, #feca85 52%, #c49d5a 92%);
                --gradient-navy: linear-gradient(180deg, #0c2348 26.479%, #031b36 100%);
                --transition: 0.3s ease;
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                font-family: "Montserrat", sans-serif;
                font-size: 16px;
                line-height: 1.4;
                color: var(--color-milk);
                background:
                    url("./assets/images/system/leaf-pattern.svg") center 27px / 101.76px 141.72px repeat,
                    var(--gradient-navy);
                background-attachment: fixed;
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .page {
                position: relative;
                z-index: 1;
                width: min(100%, 1320px);
                padding: 56px 36px 72px;
                margin: 0 auto;
            }

            /* ---------- Фон с параллаксом ----------
               Слой зафиксирован, каждая картинка сдвигается от прокрутки и мыши
               со своей глубиной (--depth), см. скрипт внизу страницы. */

            .scene {
                position: fixed;
                inset: 0;
                z-index: 0;
                overflow: hidden;
                pointer-events: none;
            }

            .scene::before,
            .scene::after {
                position: absolute;
                content: "";
                border-radius: 50%;
                filter: blur(60px);
            }

            .scene::before {
                top: -180px;
                right: -120px;
                width: 560px;
                height: 560px;
                background: rgb(215 155 87 / 22%);
            }

            .scene::after {
                bottom: -220px;
                left: -160px;
                width: 520px;
                height: 520px;
                background: rgb(128 0 32 / 28%);
            }

            .layer {
                position: absolute;
                will-change: transform;
                transform: translate3d(var(--x, 0px), var(--y, 0px), 0);
                transition: transform var(--transition);
            }

            .layer img {
                display: block;
                width: 100%;
                height: auto;
                transform: rotate(var(--rotate, 0deg));
                animation: float 8s ease-in-out infinite alternate;
                animation-delay: var(--delay, 0s);
            }

            .layer.product img {
                filter: drop-shadow(0 24px 40px rgb(3 27 54 / 55%));
            }

            .layer.leaf img {
                opacity: 0.6;
            }

            @keyframes float {
                from {
                    translate: 0 -10px;
                }

                to {
                    translate: 0 10px;
                }
            }

            .layer.l1 { top: 4%; left: -60px; width: 300px; --rotate: -18deg; }
            .layer.l2 { right: -40px; bottom: -6%; width: 340px; --rotate: 160deg; --delay: -3s; }
            .layer.p1 { top: 3%; right: 22%; width: 150px; --rotate: 14deg; --delay: -2s; }
            .layer.p2 { bottom: 6%; left: 3%; width: 190px; --rotate: -12deg; --delay: -5s; }
            .layer.p3 { top: 46%; right: -30px; width: 150px; --rotate: -8deg; --delay: -1s; }
            .layer.p4 { top: 52%; left: -40px; width: 130px; --rotate: 20deg; --delay: -6s; }

            @media (max-width: 1023.98px) {
                .layer.p3,
                .layer.p4 {
                    display: none;
                }

                .layer.p1 { top: 4%; width: 120px; right: 8%; }
                .layer.p2 { width: 140px; left: -30px; }
            }

            @media (max-width: 767.98px) {
                .layer.l1 { width: 200px; }
                .layer.l2 { width: 220px; }
                .layer.p1 { top: 2%; width: 96px; right: -24px; }
                .layer.p2 { bottom: 4%; width: 110px; left: -36px; }
            }

            @media (prefers-reduced-motion: reduce) {
                .layer img {
                    animation: none;
                }
            }

            /* ---------- Шапка ---------- */

            .hero {
                display: flex;
                gap: 32px;
                align-items: flex-end;
                justify-content: space-between;
                margin-bottom: 40px;
            }

            .brand {
                display: inline-block;
            }

            .brand img {
                display: block;
                width: 200px;
                height: auto;
            }

            .overline {
                display: block;
                margin-top: 40px;
                font-size: 14px;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: var(--color-gold);
            }

            h1 {
                margin: 8px 0 12px;
                font-family: "Cormorant SC", serif;
                font-size: clamp(44px, 5vw, 72px);
                font-weight: 600;
                line-height: 1.05;
                color: transparent;
                background: var(--gradient-gold);
                -webkit-background-clip: text;
                background-clip: text;
            }

            .intro {
                max-width: 620px;
                margin: 0;
                font-size: 18px;
                color: rgb(241 241 222 / 80%);
            }

            .icons {
                display: flex;
                flex: 0 0 auto;
                gap: 12px;
            }

            .icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 52px;
                height: 52px;
                background: rgb(241 241 222 / 6%);
                border: 1px solid var(--color-gold);
                border-radius: 50%;
                transition: background-color var(--transition);
            }

            .icon:hover {
                background-color: rgb(241 241 222 / 16%);
            }

            .icon svg {
                width: 24px;
                height: 24px;
            }

            /* ---------- Группы ---------- */

            .group {
                padding: 28px;
                color: var(--color-ink);
                background: var(--color-milk);
                border: 2px solid var(--color-gold);
                border-radius: 30px;
            }

            .group-title {
                display: flex;
                gap: 12px;
                align-items: center;
                margin: 0 0 20px;
                font-family: "Cormorant SC", serif;
                font-size: 32px;
                font-weight: 600;
                line-height: 1.1;
                color: var(--color-navy);
            }

            .group-title::before {
                flex: 0 0 auto;
                width: 12px;
                height: 12px;
                content: "";
                background: var(--gradient-gold);
                border-radius: 50%;
            }

            .list {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 12px;
                padding: 0;
                margin: 0;
                list-style: none;
            }

            .list a {
                display: flex;
                gap: 12px;
                align-items: center;
                justify-content: space-between;
                min-height: 76px;
                padding: 14px 14px 14px 20px;
                background: var(--color-cream);
                border: 1px solid rgb(215 155 87 / 35%);
                border-radius: 20px;
                transition: border-color var(--transition);
            }

            .list a:hover,
            .list a:focus-visible {
                border-color: var(--color-gold);
                outline: none;
            }

            .link-text {
                min-width: 0;
            }

            .name {
                display: block;
                font-size: 16px;
                font-weight: 600;
                line-height: 1.25;
            }

            .file {
                display: block;
                margin-top: 4px;
                overflow: hidden;
                font-size: 13px;
                color: rgb(23 33 43 / 55%);
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            /* Стрелка: контурный круг, на ховере — золотая заливка отдельным слоем */
            .arrow {
                position: relative;
                display: flex;
                flex: 0 0 auto;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                border: 1px solid var(--color-gold);
                border-radius: 50%;
            }

            .arrow::before {
                position: absolute;
                inset: -1px;
                content: "";
                background: var(--gradient-gold-button);
                border-radius: 50%;
                opacity: 0;
                transition: opacity var(--transition);
            }

            .arrow svg {
                position: relative;
                width: 20px;
                height: 20px;
                stroke: var(--color-gold);
                stroke-width: 1.5;
                stroke-linecap: round;
                stroke-linejoin: round;
                transition: stroke var(--transition);
            }

            .list a:hover .arrow::before,
            .list a:focus-visible .arrow::before {
                opacity: 1;
            }

            .list a:hover .arrow svg,
            .list a:focus-visible .arrow svg {
                stroke: var(--color-navy);
            }

            /* ---------- Подвал ---------- */

            .footer {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                align-items: center;
                justify-content: space-between;
                padding-top: 24px;
                margin-top: 40px;
                border-top: 1px solid rgb(215 155 87 / 40%);
            }

            .footer p {
                margin: 0;
                font-size: 14px;
                color: rgb(241 241 222 / 70%);
            }

            .button {
                position: relative;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 52px;
                padding: 0 32px;
                overflow: hidden;
                font-size: 16px;
                font-weight: 600;
                color: var(--color-navy);
                background: var(--gradient-gold-button);
                border-radius: 100px;
                isolation: isolate;
            }

            .button::before {
                position: absolute;
                inset: 0;
                z-index: -1;
                content: "";
                background: linear-gradient(217deg, #c49d5a 38%, #feca85 80%);
                opacity: 0;
                transition: opacity var(--transition);
            }

            .button:hover::before {
                opacity: 1;
            }

            /* ---------- Адаптив ---------- */

            @media (max-width: 1023.98px) {
                .page {
                    padding: 48px 36px 60px;
                }

                .list {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @media (max-width: 767.98px) {
                .page {
                    padding: 32px 12px 48px;
                }

                .hero {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 24px;
                    margin-bottom: 28px;
                }

                .brand img {
                    width: 150px;
                }

                .overline {
                    margin-top: 28px;
                }

                .intro {
                    font-size: 16px;
                }

                .list {
                    grid-template-columns: 1fr;
                }

                .group {
                    padding: 20px 16px;
                    border-radius: 20px;
                }

                .group-title {
                    font-size: 26px;
                }

                .list a {
                    min-height: 68px;
                    padding: 12px 12px 12px 16px;
                    border-radius: 16px;
                }

                .footer {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .button {
                    width: 100%;
                }
            }
        </style>
    </head>
    <body>
        <div class="scene" aria-hidden="true">
            <div class="layer leaf l1" data-depth="0.15"><img src="./assets/images/system/leaf-outline.svg" width="354" height="601" alt="" /></div>
            <div class="layer leaf l2" data-depth="0.25"><img src="./assets/images/system/leaf-outline.svg" width="354" height="601" alt="" /></div>
            <div class="layer product p1" data-depth="0.45"><img src="./assets/images/content/products/berries.png" width="560" height="840" alt="" decoding="async" /></div>
            <div class="layer product p2" data-depth="0.6"><img src="./assets/images/content/products/mango.png" width="560" height="840" alt="" decoding="async" /></div>
            <div class="layer product p3" data-depth="0.35"><img src="./assets/images/content/products/lime.png" width="560" height="840" alt="" decoding="async" /></div>
            <div class="layer product p4" data-depth="0.3"><img src="./assets/images/content/products/granat.png" width="560" height="840" alt="" decoding="async" /></div>
        </div>

        <main class="page">
            <section class="hero">
                <div>
                    <a class="brand" href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ title }} — сайт">
                        <img src="./assets/images/system/logo.svg" width="289" height="86" alt="{{ title }}" />
                    </a>
                    <span class="overline">Вёрстка лендинга</span>
                    <h1>Карта страниц</h1>
                    <p class="intro">Навигация по свёрстанным страницам сайта Froloff — нутрицевтики для красоты и суставов.</p>
                </div>

                <div class="icons">
                    <a class="icon" href="{{ figma }}" target="_blank" rel="noopener" aria-label="Макет в Figma">
                        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
                            <path d="M21.3333 21.3334C24.2789 21.3334 26.6667 18.9456 26.6667 16.0001C26.6667 13.0546 24.2789 10.6667 21.3333 10.6667C18.3878 10.6667 16 13.0546 16 16.0001C16 18.9456 18.3878 21.3334 21.3333 21.3334Z" fill="#19BCFE" />
                            <path d="M10.6663 31.9999C13.6119 31.9999 15.9997 29.6121 15.9997 26.6666V21.3333H10.6663C7.72082 21.3333 5.33301 23.7211 5.33301 26.6666C5.33301 29.6121 7.72082 31.9999 10.6663 31.9999Z" fill="#09CF83" />
                            <path d="M10.6663 21.3334H15.9997V10.6667H10.6663C7.72082 10.6667 5.33301 13.0546 5.33301 16.0001C5.33301 18.9456 7.72082 21.3334 10.6663 21.3334Z" fill="#A259FF" />
                            <path d="M10.6663 10.6667H15.9997V0H10.6663C7.72082 0 5.33301 2.38781 5.33301 5.33333C5.33301 8.27885 7.72082 10.6667 10.6663 10.6667Z" fill="#F24E1E" />
                            <path d="M21.3333 10.6667H16V0H21.3333C24.2789 0 26.6667 2.38781 26.6667 5.33333C26.6667 8.27885 24.2789 10.6667 21.3333 10.6667Z" fill="#FF7262" />
                        </svg>
                    </a>
                    <a class="icon" href="{{ github }}" target="_blank" rel="noopener" aria-label="Репозиторий на GitHub">
                        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
                            <path
                                fill-rule="evenodd"
                                clip-rule="evenodd"
                                d="M16 0C24.8368 0 32 7.34389 32 16.4047C32 23.6511 27.4208 29.7983 21.0672 31.9695C20.256 32.1311 19.968 31.6188 19.968 31.182C19.968 30.6412 19.9872 28.8749 19.9872 26.6797C19.9872 25.1501 19.4752 24.1518 18.9008 23.643C22.464 23.2366 26.208 21.8492 26.208 15.5484C26.208 13.7564 25.5872 12.2941 24.56 11.1453C24.7264 10.7309 25.2752 9.06233 24.4032 6.80313C24.4032 6.80313 23.0624 6.36356 20.008 8.48516C18.7296 8.12196 17.36 7.93921 16 7.93281C14.64 7.93921 13.272 8.12196 11.9952 8.48516C8.9376 6.36356 7.5936 6.80313 7.5936 6.80313C6.7248 9.06233 7.2736 10.7309 7.4384 11.1453C6.416 12.2941 5.79041 13.7564 5.79041 15.5484C5.79041 21.8332 9.52641 23.2419 13.08 23.6563C12.6224 24.0659 12.208 24.7884 12.064 25.8492C11.152 26.2684 8.8352 26.9939 7.408 24.4867C7.408 24.4867 6.5616 22.9105 4.9552 22.7953C4.9552 22.7953 3.3952 22.7746 4.8464 23.7922C4.8464 23.7922 5.8944 24.2962 6.6224 26.1922C6.6224 26.1922 7.56161 29.1201 12.0128 28.1281C12.0208 29.4993 12.0352 30.7916 12.0352 31.182C12.0352 31.6156 11.7408 32.1231 10.9424 31.9711C4.584 29.8031 0 23.6527 0 16.4047C0 7.34389 7.1648 0 16 0Z"
                                fill="#F1F1DE"
                            />
                        </svg>
                    </a>
                </div>
            </section>

            <section class="group">
                <h2 class="group-title">Страницы</h2>
                <ul class="list">
                    {{ pageLink("Главная (лендинг)", "home.html") }}
                    {{ pageLink("Страница 404", "404.html") }}
                    {{ pageLink("UI kit — общие элементы", "ui-kit.html") }}
                </ul>
            </section>

            <footer class="footer">
                <p>Карта страниц для разработки сайта · Gulp, Nunjucks, Sass, JavaScript</p>
                <a class="button" href="./home.html">Открыть главную</a>
            </footer>
        </main>

        <script>
            (() => {
                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

                const layers = [...document.querySelectorAll(".scene .layer")];
                const canHover = window.matchMedia("(hover: hover)").matches;
                let mouseX = 0;
                let mouseY = 0;
                let frame = 0;

                const update = () => {
                    frame = 0;
                    const scroll = window.scrollY;
                    layers.forEach((layer) => {
                        const depth = parseFloat(layer.dataset.depth) || 0;
                        layer.style.setProperty("--x", `${(mouseX * depth * 60).toFixed(1)}px`);
                        layer.style.setProperty("--y", `${(mouseY * depth * 60 - scroll * depth).toFixed(1)}px`);
                    });
                };

                const request = () => {
                    if (!frame) frame = requestAnimationFrame(update);
                };

                window.addEventListener("scroll", request, { passive: true });

                if (canHover) {
                    window.addEventListener("pointermove", (event) => {
                        mouseX = event.clientX / window.innerWidth - 0.5;
                        mouseY = event.clientY / window.innerHeight - 0.5;
                        request();
                    });
                }

                update();
            })();
        </script>
    </body>
</html>
