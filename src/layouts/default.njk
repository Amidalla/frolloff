{% from "components/general/consent-notice/consent-notice.njk" import render as consentNotice %}
{% from "components/general/preloader/preloader.njk" import render as preloader %}
{% from "components/general/scroll-top/scroll-top.njk" import render as scrollTop %}

<!DOCTYPE html>
<html lang="ru">
    <head>
        {% include "blocks/general/meta/meta.njk" %}
        <link rel="stylesheet" href="./css/bundle.css" />
        {# Без JS прелоадер сам не уйдёт — прячем его #}
        <noscript><style>.preloader { display: none; } body.is-loading { overflow: auto; }</style></noscript>
    </head>
    <body class="is-loading">
        {{ preloader(text="Ваше здоровье — наша репутация.") }}
        {% include "components/general/svg-defs/svg-defs.njk" %}
        <div class="site">
            {% include "blocks/general/header/header.njk" %}
            <main class="page">
                {% block content %}{% endblock %}
            </main>
            {% if not hideFooter %}
                {% include "blocks/general/footer/footer.njk" %}
            {% endif %}

            <div class="overlay"></div>
            {% include "components/general/menu/menu.njk" %}

            {{ scrollTop() }}

            {% include "components/common/modal-shop/modal-shop.njk" %}
            {% include "components/common/modal-order-success/modal-order-success.njk" %}

            {% set consentContent %}
                Мы используем файлы cookie и сервис веб-аналитики Яндекс Метрика для улучшения работы сайта. Оставаясь на
                сайте, вы соглашаетесь с <a href="#">Политикой конфиденциальности</a>.
            {% endset %}
            {{ consentNotice(content=consentContent) }}
        </div>
        <script src="./js/bundle.js"></script>
    </body>
</html>
